<script>
  // Démonstration : le bouton suit le premier sélecteur de format (libellé + prix).
  const buy = document.querySelector<HTMLButtonElement>('[data-ds-buy-button]');
  const first = document.querySelector<HTMLElement>('[data-dn-variant][data-axis="format"]');
  if (buy && first) {
    const label = buy.querySelector('.dn-btn__label') ?? buy;
    first.addEventListener('dn:variant-change', (event) => {
      const { price } = (event as CustomEvent<{ price?: number }>).detail;
      label.textContent =
        typeof price === 'number'
          ? `Ajouter au panier · ${price.toFixed(2).replace('.', ',')} €`
          : 'Ajouter au panier';
    });
    buy.addEventListener('click', () => {
      if (first.querySelector('input:checked')) return;
      const error = first.querySelector<HTMLElement>('[data-dn-variant-error]');
      if (error) {
        error.textContent = 'Choisissez un format pour continuer.';
        error.hidden = false;
      }
      first.querySelector<HTMLInputElement>('input:not(:disabled)')?.focus();
    });
  }
</script>
