---
/**
 * Gabarit des pages juridiques (étape 12) : titre, version, bandeau « document non finalisé »
 * tant que des informations obligatoires manquent (config/legal.ts), sommaire et texte.
 * Pas de sitemap (aucun data-dn-indexable) ; indexation selon l'environnement (BaseLayout).
 */
import { legalBlockers, legalVersion } from '@/config/legal';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  /** Sommaire : ancres des sections (id des <h2>). */
  toc?: { id: string; label: string }[];
}

const { title, description, canonicalPath, toc = [] } = Astro.props;
const blockers = legalBlockers();
---

<BaseLayout seo={{ title, description, canonicalPath }} showReassurance={false}>
  <article
    class="dn-section dn-container dn-legal"
    data-dn-legal-page
    data-dn-legal-version={legalVersion.id}
    data-dn-legal-blockers={blockers.length}
  >
    <header class="dn-legal__head dn-measure">
      <h1>{title}</h1>
      <p class="dn-small dn-muted">
        Version du {legalVersion.date}
        {!legalVersion.final && ' — document en préparation, non finalisé'}
      </p>
    </header>

    {blockers.length > 0 && (
      <div class="dn-legal__pending dn-measure" role="note">
        <p>
          <strong>Document non finalisé.</strong> La commande en ligne n’est pas ouverte. Informations encore
          manquantes :
        </p>
        <ul>
          {blockers.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
      </div>
    )}

    {toc.length > 0 && (
      <nav class="dn-legal__toc dn-measure" aria-label="Sommaire">
        <p class="dn-label">Sommaire</p>
        <ol>
          {toc.map((item) => (
            <li>
              <a href={`#${item.id}`}>{item.label}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="dn-legal__body dn-measure">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .dn-legal__head {
    margin-bottom: var(--dn-space-6);
  }
  .dn-legal__head p {
    margin-top: var(--dn-space-2);
  }
  .dn-legal__pending {
    margin-bottom: var(--dn-space-8);
    padding: var(--dn-space-4) var(--dn-space-5);
    border-left: var(--dn-border-width-strong) solid var(--dn-warning);
    background: var(--dn-warning-bg);
    border-radius: var(--dn-radius-sm);
    font-size: var(--dn-fs-body-sm);
    line-height: var(--dn-lh-body-sm);
  }
  .dn-legal__pending ul {
    margin-top: var(--dn-space-2);
    padding-left: var(--dn-space-5);
    list-style: disc;
  }
  .dn-legal__toc {
    margin-bottom: var(--dn-space-10);
    padding-block: var(--dn-space-4);
    border-block: var(--dn-border-width) solid var(--dn-line);
  }
  .dn-legal__toc ol {
    margin-top: var(--dn-space-3);
    padding-left: var(--dn-space-5);
    list-style: decimal;
    font-size: var(--dn-fs-body-sm);
    line-height: var(--dn-lh-body-sm);
  }
  .dn-legal__toc li + li {
    margin-top: var(--dn-space-1);
  }
  .dn-legal__body :global(h2) {
    margin-top: var(--dn-space-10);
    margin-bottom: var(--dn-space-3);
    scroll-margin-top: calc(var(--dn-header-h) + var(--dn-space-4));
  }
  .dn-legal__body :global(h3) {
    margin-top: var(--dn-space-6);
    margin-bottom: var(--dn-space-2);
  }
  .dn-legal__body :global(p + p),
  .dn-legal__body :global(p + ul),
  .dn-legal__body :global(ul + p),
  .dn-legal__body :global(p + ol),
  .dn-legal__body :global(ol + p),
  .dn-legal__body :global(dl + p),
  .dn-legal__body :global(p + dl) {
    margin-top: var(--dn-space-3);
  }
  .dn-legal__body :global(ul),
  .dn-legal__body :global(ol) {
    padding-left: var(--dn-space-5);
  }
  .dn-legal__body :global(ul) {
    list-style: disc;
  }
  .dn-legal__body :global(ol) {
    list-style: decimal;
  }
  .dn-legal__body :global(li + li) {
    margin-top: var(--dn-space-1);
  }
  .dn-legal__body :global(a) {
    color: var(--dn-green);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .dn-legal__body :global(dl) {
    display: grid;
    gap: var(--dn-space-1) var(--dn-space-4);
  }
  .dn-legal__body :global(dt) {
    font-weight: var(--dn-fw-medium);
  }
  .dn-legal__body :global(dd + dt) {
    margin-top: var(--dn-space-2);
  }
  .dn-legal__body :global(.dn-legal__box) {
    margin-top: var(--dn-space-4);
    padding: var(--dn-space-5);
    border: var(--dn-border-width-strong) solid var(--dn-line-strong);
    border-radius: var(--dn-radius-sm);
    background: var(--dn-surface);
    font-size: var(--dn-fs-body-sm);
    line-height: var(--dn-lh-body-sm);
  }
  .dn-legal__body :global(.dn-legal__box p + p),
  .dn-legal__body :global(.dn-legal__box p + ol),
  .dn-legal__body :global(.dn-legal__box ol + p) {
    margin-top: var(--dn-space-2);
  }
  .dn-legal__body :global(.dn-legal__missing) {
    color: var(--dn-ink-2);
    font-style: italic;
  }
  @media (min-width: 768px) {
    .dn-legal__body :global(dl) {
      grid-template-columns: minmax(10rem, max-content) 1fr;
    }
    .dn-legal__body :global(dd + dt) {
      margin-top: 0;
    }
  }
</style>
