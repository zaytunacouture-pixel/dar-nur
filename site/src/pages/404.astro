---
/**
 * 404 : jamais de redirection silencieuse vers l'accueil. Collection, marque, produit
 * inconnu ou brouillon (aucune page générée) aboutissent ici ; Netlify sert 404.html avec le
 * statut 404.
 */
import Button from '@/components/ui/Button.astro';
import { navigation } from '@/config/navigation';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  seo={{
    title: 'Page introuvable',
    description: 'Cette adresse n’existe pas ou plus sur Dar Nūr.',
    noindex: true,
  }}
>
  <section class="dn-section dn-container dn-stack dn-measure">
    <h1>Page introuvable</h1>
    <p class="dn-body-lg dn-muted">
      Cette adresse n’existe pas ou plus. Vous pouvez reprendre depuis l’un de nos univers ou utiliser la
      recherche.
    </p>
    <div class="dn-404__links">
      {navigation.map((item) => (
        <Button variant="secondary" href={item.href}>
          {item.label}
        </Button>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .dn-404__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--dn-space-3);
  }
</style>
