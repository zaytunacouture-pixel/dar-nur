---
/**
 * Mini-panier (tiroir, §N.2) — RÉEL depuis l'étape 10 : lit le panier local (src/scripts/
 * cart-store.ts), quantités et retrait, sous-total, livraison « à confirmer », accès au panier et
 * à la demande de commande. Aucun paiement ici : le total final (livraison comprise) est confirmé
 * par Dar Nūr après la demande.
 * `demo` (pages /demo/ et /design-system/ seulement) : panier FICTIF étiqueté, inactif.
 */
import Button from '@/components/ui/Button.astro';
import Drawer from '@/components/ui/Drawer.astro';
import Icon from '@/components/ui/Icon.astro';
import IconButton from '@/components/ui/IconButton.astro';
import { currentShipping } from '@/config/commerce';
import { universes } from '@/config/navigation';
import { demoCartCount, demoCartLines, demoCartSubtotal } from '@/data/demo/cart';
import { formatPrice } from '@/lib/format';
import FreeShippingProgress from './FreeShippingProgress.astro';

interface Props {
  demo?: boolean;
}

const { demo = false } = Astro.props;
---

{demo ? (
  <Drawer id="dn-cart" title={`Panier (${demoCartCount})`} side="right">
    <div class="dn-cart__content">
      <p class="dn-cart__demo dn-label">Démonstration — panier fictif, aucune commande possible</p>
      <FreeShippingProgress policy={currentShipping} subtotal={demoCartSubtotal} />
      <ul class="dn-cart__lines" role="list">
        {demoCartLines.map((line) => (
          <li class="dn-cartline">
            <span class="dn-cartline__thumb" aria-hidden="true" />
            <div class="dn-cartline__info">
              <p class="dn-cartline__name">{line.name}</p>
              {line.variant && <p class="dn-small dn-muted">{line.variant}</p>}
              <div class="dn-cartline__row">
                <div class="dn-qty" role="group" aria-label={`Quantité de ${line.name}`}>
                  <IconButton icon="minus" label="Diminuer la quantité" disabled={line.quantity <= 1} />
                  <span class="dn-qty__value">{line.quantity}</span>
                  <IconButton icon="plus" label="Augmenter la quantité" />
                </div>
                <span class="dn-cartline__total">{formatPrice(line.quantity * line.unitPrice)}</span>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
    <div slot="footer" class="dn-cart__footer">
      <p class="dn-cart__subtotal">
        <span>Sous-total</span>
        <span>{formatPrice(demoCartSubtotal)}</span>
      </p>
      <Button size="lg" fullWidth disabled>
        Envoyer ma demande de commande
      </Button>
      <p class="dn-small dn-muted dn-cart__demo">Bouton inactif : démonstration du composant.</p>
    </div>
  </Drawer>
) : (
  <Drawer id="dn-cart" title="Panier" side="right">
    <div class="dn-cart__empty" data-dn-cart-empty>
      <h3>Votre panier est vide.</h3>
      <div class="dn-cart__empty-links">
        {universes.map((u) => (
          <Button variant="secondary" href={u.href} fullWidth>
            {u.label}
          </Button>
        ))}
      </div>
    </div>
    <div class="dn-cart__content" data-dn-cart-filled hidden>
      <ul
        class="dn-cart__lines"
        role="list"
        data-dn-cart-lines
        tabindex="-1"
        aria-label="Articles du panier"
      />
    </div>
    <p class="dn-visually-hidden" aria-live="polite" data-dn-cart-live />
    <div slot="footer" class="dn-cart__footer" data-dn-cart-footer hidden>
      <p class="dn-cart__subtotal">
        <span>Sous-total</span>
        <span data-dn-cart-subtotal />
      </p>
      <p class="dn-small dn-muted dn-cart__shipping">
        <Icon name="truck" size={16} />
        <span>Livraison : frais confirmés par Dar Nūr avant paiement.</span>
      </p>
      <Button href="/commande/" size="lg" fullWidth>
        Envoyer ma demande de commande
      </Button>
      <Button href="/panier/" variant="tertiary" fullWidth>
        Voir le panier
      </Button>
      <p class="dn-small dn-muted">Aucun paiement à cette étape.</p>
    </div>
  </Drawer>
)}

{/* Icônes clonées par le rendu JavaScript des lignes (src/scripts/cart-view.ts). */}
<template id="dn-icon-minus">
  <Icon name="minus" size={20} />
</template>
<template id="dn-icon-plus">
  <Icon name="plus" size={20} />
</template>

<style>
  .dn-cart__empty {
    display: grid;
    gap: var(--dn-space-6);
    padding: var(--dn-space-8) var(--dn-space-4);
  }
  .dn-cart__empty[hidden],
  .dn-cart__content[hidden],
  .dn-cart__footer[hidden] {
    display: none;
  }
  .dn-cart__empty-links {
    display: grid;
    gap: var(--dn-space-3);
  }
  .dn-cart__content {
    display: grid;
    gap: var(--dn-space-4);
    padding: var(--dn-space-2) var(--dn-space-4) var(--dn-space-4);
  }
  .dn-cart__demo {
    color: var(--dn-warning);
  }
  .dn-cart__lines {
    display: grid;
  }
  .dn-cart__lines:focus {
    outline: none;
  }
  .dn-cart__footer {
    display: grid;
    gap: var(--dn-space-3);
  }
  .dn-cart__subtotal {
    display: flex;
    justify-content: space-between;
    font-variant-numeric: tabular-nums;
    font-weight: var(--dn-fw-medium);
  }
  .dn-cart__shipping {
    display: flex;
    gap: var(--dn-space-2);
    align-items: center;
  }
</style>

<script>
  import { formatCents } from '@/lib/orders/labels';
  import { cartCount, cartSubtotal, onCartChange, readCart, type CartLine } from '@/scripts/cart-store';
  import { renderLines } from '@/scripts/cart-view';

  const drawer = document.getElementById('dn-cart');
  const list = drawer?.querySelector<HTMLElement>('[data-dn-cart-lines]');

  /** Compteur du header (pastille + nom accessible du bouton). */
  function renderCount(lines: CartLine[]) {
    const count = cartCount(lines);
    for (const badge of document.querySelectorAll<HTMLElement>('[data-dn-cart-count]')) {
      badge.textContent = count > 9 ? '9+' : String(count);
      badge.hidden = count === 0;
    }
    for (const button of document.querySelectorAll<HTMLElement>('[data-dn-cart-button]')) {
      button.setAttribute(
        'aria-label',
        count ? `Ouvrir le panier, ${count} article${count > 1 ? 's' : ''}` : 'Ouvrir le panier, vide',
      );
    }
  }

  function renderDrawer(lines: CartLine[]) {
    if (!drawer || !list) return;
    const filled = lines.length > 0;
    drawer.querySelector<HTMLElement>('[data-dn-cart-empty]')!.hidden = filled;
    drawer.querySelector<HTMLElement>('[data-dn-cart-filled]')!.hidden = !filled;
    drawer.querySelector<HTMLElement>('[data-dn-cart-footer]')!.hidden = !filled;
    const title = drawer.querySelector('.dn-drawer__title');
    if (title) title.textContent = filled ? `Panier (${cartCount(lines)})` : 'Panier';
    drawer.querySelector('[data-dn-cart-subtotal]')!.textContent = formatCents(cartSubtotal(lines));
    renderLines(list, lines, { editable: true });
  }

  if (list) {
    let previous = readCart().length;
    renderCount(readCart());
    renderDrawer(readCart());
    onCartChange((lines) => {
      renderCount(lines);
      renderDrawer(lines);
      if (lines.length < previous) {
        drawer!.querySelector('[data-dn-cart-live]')!.textContent = 'Article retiré du panier.';
        list.focus();
      }
      previous = lines.length;
    });
  }
</script>
