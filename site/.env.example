# Copier en .env pour le développement local. Aucune de ces valeurs n'est secrète :
# l'URL Supabase et la clé « publishable » sont déjà publiques (js/config.js de l'ancien site)
# et ne donnent qu'une lecture filtrée par RLS. Ne JAMAIS mettre ici de clé service_role / sb_secret.

# development (défaut) | preprod | production — seule "production" autorise l'indexation.
DAR_NUR_ENV=development

# URL absolue du site (canonical). Sur Netlify, DEPLOY_PRIME_URL est utilisée à défaut.
# SITE_URL=http://localhost:4321

SUPABASE_URL=https://sxlpgcnjerlayitaxxyv.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
