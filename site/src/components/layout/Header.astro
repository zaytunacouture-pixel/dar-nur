---
/**
 * Header (§H.2 / §H.3) : fond crème, fixe, sans compte client.
 * Mobile/tablette (60 px) : menu + recherche | logo centré | panier.
 * Desktop ≥ 1024 (76 px) : logo | 5 entrées (méga-menu pour les 3 univers) | recherche + panier.
 * HTML statique ; seul le méga-menu a un petit script (intention de survol, clavier).
 */
import IconButton from '@/components/ui/IconButton.astro';
import Icon from '@/components/ui/Icon.astro';
import { navigation } from '@/config/navigation';
import Logo from './Logo.astro';

interface Props {
  currentPath: string;
  /** Entrée de premier niveau de la page (univers d'une collection), pour la marquer courante. */
  section?: string | undefined;
  cartCount?: number;
}

const { currentPath, section, cartCount = 0 } = Astro.props;
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(href) || section === href;
const cartLabel =
  cartCount > 0
    ? `Ouvrir le panier, ${cartCount} article${cartCount > 1 ? 's' : ''}`
    : 'Ouvrir le panier, vide';
---

<header class="dn-header" data-dn-header>
  <div class="dn-header__bar dn-container">
    <div class="dn-header__start">
      <IconButton
        icon="menu"
        label="Ouvrir le menu"
        class="dn-header__mobile-only"
        data-dn-open="dn-mobile-menu"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="dn-mobile-menu"
      />
      <IconButton
        icon="search"
        label="Rechercher"
        class="dn-header__mobile-only"
        data-dn-open="dn-search"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="dn-search"
      />
    </div>

    <a href="/" class="dn-header__logo" aria-label="Dar Nūr — accueil">
      <Logo />
    </a>

    <nav class="dn-mainnav" aria-label="Navigation principale">
      <ul class="dn-mainnav__list" role="list">
        {navigation.map((item) =>
          item.kind === 'universe' ? (
            <li class="dn-mainnav__item" data-dn-mega-item>
              <button
                type="button"
                class:list={['dn-mainnav__entry', { 'is-current': isCurrent(item.href) }]}
                aria-expanded="false"
                aria-controls={`dn-mega-${item.id}`}
                data-dn-mega-trigger
              >
                {item.label}
                <Icon name="chevron-down" size={16} class="dn-mainnav__chevron" />
              </button>
              <div class="dn-mega" id={`dn-mega-${item.id}`} hidden data-dn-mega-panel>
                <div class="dn-mega__inner dn-container">
                  <div class="dn-mega__head">
                    <p class="dn-label dn-muted">{item.label}</p>
                    <a class="dn-mega__all" href={item.href}>
                      Tout voir {item.label}
                      <Icon name="arrow-right" size={16} />
                    </a>
                  </div>
                  <div class="dn-mega__groups">
                    {item.groups.map((group) => (
                      <div class="dn-mega__group">
                        {group.title && <p class="dn-label dn-muted dn-mega__group-title">{group.title}</p>}
                        <ul role="list">
                          {group.links.map((link) => (
                            <li>
                              <a
                                class="dn-mega__link"
                                href={link.href}
                                aria-current={currentPath === link.href ? 'page' : undefined}
                              >
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                  {item.feature && (
                    <a class="dn-mega__feature" href={item.feature.href}>
                      <span class="dn-label dn-muted">À découvrir</span>
                      <span class="dn-mega__feature-title">{item.feature.label}</span>
                      <Icon name="arrow-right" size={20} />
                    </a>
                  )}
                </div>
              </div>
            </li>
          ) : (
            <li class="dn-mainnav__item">
              <a
                class:list={['dn-mainnav__entry', { 'is-current': isCurrent(item.href) }]}
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <div class="dn-header__end">
      <IconButton
        icon="search"
        label="Rechercher"
        class="dn-header__desktop-only"
        data-dn-open="dn-search"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="dn-search"
      />
      <IconButton
        icon="shopping-bag"
        label={cartLabel}
        data-dn-open="dn-cart"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="dn-cart"
        data-dn-cart-button
      >
        <span class="dn-header__count" data-dn-cart-count hidden={cartCount === 0} aria-hidden="true">
          {cartCount > 9 ? '9+' : cartCount}
        </span>
      </IconButton>
    </div>
  </div>
  <div class="dn-mega-scrim" data-dn-mega-scrim hidden></div>
</header>

<style>
  .dn-header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--dn-z-header);
    background: var(--dn-bg);
    /* Filet au défilement en ombre portée d'1 px : ne modifie pas la hauteur (60 / 76 px). */
    transition: box-shadow var(--dn-dur-fast) var(--dn-ease-in-out);
  }
  .dn-header[data-scrolled] {
    box-shadow: 0 var(--dn-border-width) 0 var(--dn-line);
  }
  .dn-header__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    block-size: var(--dn-header-h);
  }
  .dn-header__start {
    display: flex;
    gap: var(--dn-space-1);
    margin-inline-start: calc(-1 * var(--dn-space-3));
  }
  .dn-header__end {
    display: flex;
    gap: var(--dn-space-1);
    justify-content: flex-end;
    margin-inline-end: calc(-1 * var(--dn-space-3));
  }
  .dn-header__logo {
    display: block;
    border-radius: var(--dn-radius-sm);
  }
  .dn-header__desktop-only,
  .dn-mainnav {
    display: none;
  }
  .dn-header__count {
    position: absolute;
    inset-block-start: 4px;
    inset-inline-end: 2px;
    display: grid;
    place-items: center;
    min-inline-size: var(--dn-cart-count);
    block-size: var(--dn-cart-count);
    padding-inline: var(--dn-space-1);
    border: var(--dn-border-width-strong) solid var(--dn-bg);
    border-radius: var(--dn-radius-pill);
    box-sizing: content-box;
    background: var(--dn-green);
    color: var(--dn-on-dark);
    font-size: var(--dn-fs-badge-count);
    font-weight: var(--dn-fw-medium);
    font-variant-numeric: tabular-nums;
    line-height: var(--dn-lh-tight);
  }
  .dn-header__count[hidden] {
    display: none;
  }

  @media (min-width: 1024px) {
    .dn-header__bar {
      grid-template-columns: auto 1fr auto;
      gap: var(--dn-space-8);
    }
    .dn-header__start,
    .dn-header :global(.dn-header__mobile-only) {
      display: none;
    }
    .dn-header :global(.dn-header__desktop-only) {
      display: inline-grid;
    }
    .dn-mainnav {
      display: block;
      justify-self: center;
    }
  }

  /* ── Navigation principale ─────────────────────────────────── */
  .dn-mainnav__list {
    display: flex;
    gap: var(--dn-space-8);
  }
  .dn-mainnav__entry {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--dn-space-1);
    min-block-size: var(--dn-tap-min);
    padding: 0;
    border: 0;
    background: none;
    font-size: var(--dn-fs-nav);
    font-weight: var(--dn-fw-medium);
    color: var(--dn-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .dn-mainnav__entry::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 6px;
    border-bottom: var(--dn-border-width) solid var(--dn-green);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dn-dur-fast) var(--dn-ease-out);
  }
  .dn-mainnav__entry:hover::after,
  .dn-mainnav__entry.is-current::after,
  .dn-mainnav__entry[aria-expanded='true']::after {
    transform: scaleX(1);
  }
  .dn-mainnav__entry :global(.dn-mainnav__chevron) {
    transition: transform var(--dn-dur-base) var(--dn-ease-out);
  }
  .dn-mainnav__entry[aria-expanded='true'] :global(.dn-mainnav__chevron) {
    transform: rotate(180deg);
  }

  /* ── Méga-menu (§H.4) ──────────────────────────────────────── */
  .dn-mega {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    z-index: var(--dn-z-megamenu);
    background: var(--dn-bg);
    border-top: var(--dn-border-decor);
    box-shadow: var(--dn-shadow-overlay);
    animation: dn-mega-in var(--dn-dur-base) var(--dn-ease-out);
  }
  @keyframes dn-mega-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  .dn-mega__inner {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) 3fr minmax(220px, 1fr);
    gap: var(--dn-space-10);
    padding-block: var(--dn-space-8) var(--dn-space-10);
    max-block-size: 360px;
  }
  .dn-mega__head {
    display: grid;
    align-content: start;
    gap: var(--dn-space-3);
  }
  .dn-mega__all {
    display: inline-flex;
    align-items: center;
    gap: var(--dn-space-2);
    font-size: var(--dn-fs-button);
    font-weight: var(--dn-fw-medium);
    text-decoration: none;
  }
  .dn-mega__all:hover {
    color: var(--dn-green);
    text-decoration: underline;
  }
  .dn-mega__groups {
    display: flex;
    gap: var(--dn-space-16);
  }
  .dn-mega__group-title {
    margin-bottom: var(--dn-space-2);
  }
  .dn-mega__link {
    display: flex;
    align-items: center;
    min-block-size: 36px;
    font-size: var(--dn-fs-body);
    text-decoration: none;
  }
  .dn-mega__link:hover,
  .dn-mega__link[aria-current='page'] {
    color: var(--dn-green);
    text-decoration: underline;
  }
  /* Tuile : sans photo tant que les visuels d'univers ne sont pas produits (shooting). */
  .dn-mega__feature {
    display: grid;
    align-content: end;
    gap: var(--dn-space-2);
    min-block-size: 200px;
    padding: var(--dn-space-6);
    border-radius: var(--dn-radius-md);
    background: var(--dn-bg-alt);
    text-decoration: none;
  }
  .dn-mega__feature-title {
    font-family: var(--dn-font-serif);
    font-size: var(--dn-fs-h3);
    font-weight: var(--dn-fw-semibold);
    line-height: var(--dn-lh-h3);
  }
  .dn-mega__feature:hover .dn-mega__feature-title {
    color: var(--dn-green);
  }
  /* Voile à 24 % sous le header (0,48 × 0,5), desktop seulement. */
  .dn-mega-scrim {
    display: none;
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    z-index: -1;
    block-size: 100dvh;
    background: var(--dn-scrim);
    opacity: 0.5;
    pointer-events: none;
  }
  @media (min-width: 1024px) {
    .dn-mega-scrim:not([hidden]) {
      display: block;
    }
  }
</style>

<script>
  // ── État « défilé » : bordure basse dès 8 px ───────────────────
  const header = document.querySelector<HTMLElement>('[data-dn-header]');
  if (header) {
    const sentinel = document.createElement('div');
    sentinel.style.cssText = 'position:absolute;top:8px;height:1px;width:1px;pointer-events:none';
    document.body.prepend(sentinel);
    new IntersectionObserver(([entry]) =>
      header.toggleAttribute('data-scrolled', !entry?.isIntersecting),
    ).observe(sentinel);
  }

  // ── Méga-menu : survol avec intention, clic, clavier ───────────
  const items = [...document.querySelectorAll<HTMLElement>('[data-dn-mega-item]')];
  const scrim = document.querySelector<HTMLElement>('[data-dn-mega-scrim]');
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const OPEN_DELAY = 150;
  const CLOSE_DELAY = 250;
  let openTimer: number | undefined;
  let closeTimer: number | undefined;

  const parts = (item: HTMLElement) => ({
    trigger: item.querySelector<HTMLButtonElement>('[data-dn-mega-trigger]')!,
    panel: item.querySelector<HTMLElement>('[data-dn-mega-panel]')!,
  });

  function closeAll(except?: HTMLElement) {
    for (const item of items) {
      if (item === except) continue;
      const { trigger, panel } = parts(item);
      trigger.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
    }
    if (!except && scrim) scrim.hidden = true;
  }

  function openItem(item: HTMLElement) {
    closeAll(item);
    const { trigger, panel } = parts(item);
    trigger.setAttribute('aria-expanded', 'true');
    panel.hidden = false;
    if (scrim) scrim.hidden = false;
  }

  for (const item of items) {
    const { trigger, panel } = parts(item);

    trigger.addEventListener('click', () => {
      window.clearTimeout(openTimer);
      if (trigger.getAttribute('aria-expanded') === 'true') closeAll();
      else openItem(item);
    });

    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        openItem(item);
        panel.querySelector<HTMLAnchorElement>('a')?.focus();
      }
    });

    item.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        closeAll();
        trigger.focus();
      }
    });

    // Fermeture quand le focus quitte l'entrée et son panneau (Tab au-delà du dernier lien).
    item.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && !item.contains(next) && trigger.getAttribute('aria-expanded') === 'true') closeAll();
    });

    if (canHover) {
      item.addEventListener('pointerenter', () => {
        window.clearTimeout(closeTimer);
        const anyOpen = items.some((i) => parts(i).trigger.getAttribute('aria-expanded') === 'true');
        // Passer d'une entrée à l'autre bascule sans délai.
        openTimer = window.setTimeout(() => openItem(item), anyOpen ? 0 : OPEN_DELAY);
      });
      item.addEventListener('pointerleave', () => {
        window.clearTimeout(openTimer);
        closeTimer = window.setTimeout(() => closeAll(), CLOSE_DELAY);
      });
    }
  }

  document.addEventListener('click', (event) => {
    if (!items.some((item) => item.contains(event.target as Node))) closeAll();
  });
</script>
